{
  "name": "framework_sdk_cli",
  "version": "0.2.0",
  "description": "Workers-World Agent CLI 基建：进程信封、门户 runPortal、confirm、WorkerIo 映射（无业务命令）",
  "type": "module",
  "license": "UNLICENSED",
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "prepublishOnly": "npm run build",
    "lint": "npx --yes @biomejs/biome@2.5.1 check src test",
    "format": "npx --yes @biomejs/biome@2.5.1 format --write src test",
    "typecheck": "tsc --noEmit -p tsconfig.src.json",
    "check": "npm run lint && npm run typecheck"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./envelope": {
      "import": "./dist/envelope/index.js",
      "types": "./dist/envelope/index.d.ts"
    },
    "./argv": {
      "import": "./dist/argv/index.js",
      "types": "./dist/argv/index.d.ts"
    },
    "./http": {
      "import": "./dist/http/index.js",
      "types": "./dist/http/index.d.ts"
    },
    "./portal": {
      "import": "./dist/portal/index.js",
      "types": "./dist/portal/index.d.ts"
    },
    "./search": {
      "import": "./dist/search/index.js",
      "types": "./dist/search/index.d.ts"
    },
    "./workspace": {
      "import": "./dist/workspace/index.js",
      "types": "./dist/workspace/index.d.ts"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "@workers-world:registry": "https://npm.pkg.github.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/workers-world/framework_sdk_cli.git"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "tsup": "^8.4.0",
    "typescript": "^5.8.2",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=20.12.0"
  }
}
